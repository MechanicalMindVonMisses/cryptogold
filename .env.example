# Copy to .env.local and fill in. Values here are read on the server only.

# Required: FreeCryptoAPI key for live coin prices (https://freecryptoapi.com).
# The free plan allows 100,000 requests a month; recording every 60 s uses about 44,000.
FREECRYPTOAPI_KEY=

# Optional: CoinGecko Demo key (https://www.coingecko.com/en/developers/dashboard). Without it the keyless
# public API is used for search, coin names and the 24h change, with lower rate limits.
# COINGECKO_DEMO_API_KEY=

# Optional: public address when the site is online, e.g. www.cryptogold.me. Requests for the bare
# domain are redirected to it. Read at build time (run npm run build after changing it).
# PUBLIC_HOST=www.cryptogold.me

# Optional: where recorded price history is stored (SQLite file, created on first start).
# AURATIO_DB_PATH=data/auratio.db

# Optional: FreeCryptoAPI requests allowed per UTC day (default 3200, about 97k a month).
# FREECRYPTOAPI_DAILY_BUDGET=3200

# Optional: turn the background price recorder off ("off") or slow it down (seconds, minimum 60).
# RECORDER=on
# RECORD_INTERVAL_SECONDS=60

# Optional: Binance REST base URL (last-resort PAXG gold price). Use https://data-api.binance.vision if
# api.binance.com is blocked.
# BINANCE_BASE_URL=https://api.binance.com
